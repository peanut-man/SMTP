# ─────────────────────────────────────────────────────────────────────────────
# SMTP Mail Management Platform — Environment Variables
# Copy this file to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────────────────

# Application
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-32chars

# SMTP credential encryption key (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://smtp_user:smtp_pass@localhost:5432/smtp_db

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File storage
STORAGE_PATH=/app/storage/attachments
MAX_ATTACHMENT_SIZE_MB=25

# Email worker
WORKER_POLL_INTERVAL=5
DEFAULT_MAX_RETRIES=3
RETRY_BASE_DELAY=60

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development
